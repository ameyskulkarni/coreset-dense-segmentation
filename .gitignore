__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
wandb/
.idea/

# heavy, regenerable artifacts — everything needed to reproduce them is in git
# (configs + results/subsets/*.json + results/rare_classes/*.json)
results/checkpoints/
results/features/
*.pt

# scratch/working ledger + ad hoc exports (runs.csv, W&B exports, notes) — deliberately
# NOT version-controlled: freely edited without needing a commit first. Each row already
# self-describes its provenance via its own git_commit/config_hash columns, so this
# folder not being tracked doesn't lose reproducibility.
results/metrics/

# scratch experiment-launcher scripts (sweeps, calibration runs) — freely editable without
# a commit first. These are convenience orchestration only; the actual hyperparameters used
# by any given run are independently captured per-run (config.yaml + config_hash in
# results/metrics/runs.csv), gated by the tracked recipe YAMLs, so this isn't load-bearing
# for reproducibility the way scripts/ or segcoreset/ are.
scripts/experiments/
